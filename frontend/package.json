{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local-dev.ps1",
    "dev:public": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-public-dev.ps1",
    "build:public": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-public.ps1",
    "start:public": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-public.ps1",
    "tunnel:public": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start-dishy-tunnel.ps1",
    "deploy:public": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/deploy-public.ps1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "test:agent": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "js-cookie": "^3.0.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "katex": "^0.17.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "swiper": "^14.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.34",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "8.5.19",
    "sharp": "0.35.0"
  }
}
