EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_WEB_URL=https://app.example.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<your-google-web-client-id>
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<your-google-ios-client-id>
# Optional per-machine override of the EAS project committed in app.json. Only for serving Metro
# to iOS under your own EAS project - never set when building the APK. See README.md.
# EXPO_EAS_PROJECT_ID=<your-eas-project-id>
# EXPO_EAS_OWNER=<your-expo-account-name>
# Alternative to "npx eas-cli login" for the machine serving Metro to iOS (README: "On iOS, stay on Expo Go").
# EXPO_TOKEN=<your-personal-expo-access-token>
