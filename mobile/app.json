{
  "expo": {
    "name": "Dishy",
    "slug": "restaurant-hub-mobile",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "default",
    "backgroundColor": "#FFF7ED",
    "icon": "./assets/images/icon.png",
    "scheme": "restauranthub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "pro.dishy.restauranthub"
    },
    "android": {
      "package": "pro.dishy.restauranthub",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7ED"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "อนุญาตให้ Dishy เข้าถึงคลังรูปเพื่อเลือกรูปเมนู",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "อนุญาตให้ Dishy ใช้ไมโครโฟนเพื่อพูดคำถามแทนการพิมพ์"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8bcb07d4-1e03-4efb-a214-8b7cc43a5c60"
      }
    }
  }
}
